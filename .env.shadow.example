# Must point to storage that survives container replacement and redeployment.
V3_DATA_HOST_PATH=/absolute/path/on/persistent/disk/btcturk-v3
# Optional, deliberately separate from V1 Telegram credentials.
V3_TELEGRAM_BOT_TOKEN=
V3_TELEGRAM_CHAT_ID=
V3_API_FAILURE_ALERT_THRESHOLD=3
V3_ALERT_COOLDOWN_SECONDS=21600
V3_HEALTH_SUMMARY_SECONDS=86400
V3_GAP_WARNING_SECONDS=600
V3_GAP_FAIL_SECONDS=1800
V3_NAN_WARNING_RATE=0.10
V3_NAN_FAIL_RATE=0.25
V3_LABEL_WARNING_RATE=0.90
