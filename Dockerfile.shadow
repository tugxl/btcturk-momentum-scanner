FROM python:3.12-slim
WORKDIR /app
COPY requirements-shadow.txt .
RUN pip install --no-cache-dir -r requirements-shadow.txt
COPY *.py config.example.yaml ./
RUN useradd --create-home scanner && mkdir -p /data/v3 && chown -R scanner:scanner /data/v3
USER scanner
ENV PYTHONUNBUFFERED=1 SCANNER_V3_DATA_DIR=/data/v3
HEALTHCHECK --interval=5m --timeout=10s --start-period=10m --retries=2 \
  CMD ["python", "shadow_healthcheck.py", "--db", "/data/v3/shadow.sqlite3", "--max-age", "900"]
CMD ["python", "scanner.py", "--shadow-watch"]
